    "react-router-dom": "^6.30.6",
    "react-textarea-autosize": "^8.5.9",
    "react-transition-state": "^2.4.1",
    "rehype-highlight": "^7.0.2",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "threadiverse": "^0.21.2",
    "ua-parser-js": "^2.0.10",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "use-long-press": "^3.3.0",
    "virtua": "^0.54.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@ionic/cli": "^7.2.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@trapezedev/configure": "^7.1.11",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "mdast-util-lemmy-spoiler": "^2.0.0",
    "oxc-transform-react": "^0.156.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "pwa-asset-generator": "^8.1.7",
    "release-it": "^21.1.1",
    "typed-css-modules": "^0.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5"
  }
}
